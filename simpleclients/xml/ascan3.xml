<?xml version="1.0" ?>
<definition>
  <group name="entry1" type="NXentry">
    <group name="instrument" type="NXinstrument">
      <group name="detector" type="NXdetector">
        <field name="counter1" type="NX_FLOAT" units="m">
          <strategy mode="STEP"/>
          <datasource name="exp_c01" type="CLIENT">
            <record name="exp_c01"/>
          </datasource>
          <attribute name="short_name" type="NX_CHAR">
            <strategy mode="INIT"/>
            <datasource name="short_name" type="CLIENT">
              <record name="short_name"/>
            </datasource>
          </attribute>
          <attribute name="some_numbers" type="NX_FLOAT">
            <dimensions rank="1">
              <dim index="1" value="3"/>
            </dimensions>
	    1 2 3
          </attribute>
          <attribute name="some_numbers2" type="NX_FLOAT">
            <dimensions rank="2">
              <dim index="1" value="2"/>
              <dim index="2" value="2"/>
            </dimensions>
	    1 2 
	    3 4
          </attribute>
        </field>
        <field name="counter2" type="NX_FLOAT" units="s">
          <strategy mode="STEP"/>
          <datasource name="exp_c02" type="CLIENT">
            <record name="exp_c02"/>
          </datasource>
        </field>
        <field name="mca" type="NX_FLOAT" units="">
          <dimensions rank="1">
            <dim index="1" value="2048"/>
          </dimensions>
          <strategy mode="STEP"/>
          <datasource name="p09/mca/exp.02" type="TANGO">
            <device member="attribute" name="p09/mca/exp.02"/>
            <record name="Data"/>
          </datasource>
        </field>
        <field name="mcabis" type="NX_FLOAT" units="">
          <dimensions rank="1">
            <dim index="1" value="2048"/>
          </dimensions>
          <strategy grows="2" mode="STEP"/>
          <datasource name="p09/mca/exp.02" type="TANGO">
            <device member="attribute" name="p09/mca/exp.02"/>
            <record name="Data"/>
          </datasource>
        </field>
      </group>
    </group>
    <group name="data" type="NXdata">
      <link name="data" target="/NXentry/instrument:NXinstrument/NXdetector/mca">
        <doc>
          Link to mca in /NXentry/instrument:NXinstrument/NXdetector
        </doc>
      </link>
      <link name="counter1" target="/NXentry/instrument:NXinstrument/NXdetector/counter1">
        <doc>
          Link to counter1 in /NXentry/instrument:NXinstrument/NXdetector
        </doc>
      </link>
      <link name="counter2" target="/NXentry/instrument:NXinstrument/NXdetector/counter2">
        <doc>
          Link to counter2 in /NXentry/instrument:NXinstrument/NXdetector
        </doc>
      </link>
    </group>
  </group>
</definition>
